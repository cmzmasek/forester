            <rank>species</rank>
          </taxonomy>
        </clade>
      </clade>
      <clade>
        <name>BCL2_mouse</name>
        <branch_length>0.02</branch_length>
        <taxonomy>
          <scientific_name>Mus musculus</scientific_name>
          <rank>species</rank>
        </taxonomy>
      </clade>
    </clade>
    <clade>
