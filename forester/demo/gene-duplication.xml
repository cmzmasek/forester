          <branch_length>0.02</branch_length>
          <taxonomy>
            <scientific_name>Homo sapiens</scientific_name>
            <rank>species</rank>
          </taxonomy>
        </clade>
        <clade>
          <name>BCL2_chimp</name>
          <branch_length>0.02</branch_length>
          <taxonomy>
